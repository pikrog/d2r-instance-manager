<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:designViewModels="clr-namespace:D2RInstanceManager.Design.ViewModels"
             xmlns:delete="clr-namespace:D2RInstanceManager.Overlay.Dialog.Delete"
             xmlns:local="clr-namespace:D2RInstanceManager.Instance.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="D2RInstanceManager.Instance.Views.DeleteInstanceDialogView"
             x:DataType="local:DeleteInstanceDialogViewModel">
    <Design.DataContext>
        <designViewModels:DeleteInstanceDialogDesignViewModel/>
    </Design.DataContext>
    
    <delete:DeleteDialog Actions="{Binding}">
        <delete:DeleteDialog.Title>
            Delete instance?
        </delete:DeleteDialog.Title>
        
        <delete:DeleteDialog.Body>
            <StackPanel Classes="dialog-text">
                <TextBlock Classes="paragraph">
                    <Run>Are you sure you want to delete the instance </Run>
                    <Run FontWeight="Bold" Text="{Binding InstanceName}" /><Run>?</Run>
                </TextBlock>
            </StackPanel>
        </delete:DeleteDialog.Body>
    </delete:DeleteDialog>
</UserControl>
