<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:log="clr-namespace:AvaloniaApplication1.Log"
             xmlns:design="clr-namespace:AvaloniaApplication1.Design.ViewModels"
             xmlns:controls="clr-namespace:AvaloniaApplication1.Controls"
             xmlns:filter="clr-namespace:AvaloniaApplication1.Log.Filter"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Log.LogsPageView"
             x:DataType="log:LogsPageViewModel">
    
    <Design.DataContext>
        <design:LogsPageDesignViewModel />
    </Design.DataContext>
    
    <UserControl.Resources>
        <log:LogLevelToSemanticTypeConverter x:Key="LogLevelToSemanticTypeConverter" />
        
        <Color x:Key="TableViewColumnHeaderSeparatorBackground">Transparent</Color>
    </UserControl.Resources>
    
    <UserControl.Styles>
        
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningContent}" />
        </Style>
        
        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerContent}" />
        </Style>
        
        <Style Selector="TextBlock.info">
            <Setter Property="Foreground" Value="{DynamicResource InfoContent}" />
        </Style>
        
        <Style Selector="Panel.filter-summary TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        
    </UserControl.Styles>
    
    <Border Classes="outlined hovering rounded" Margin="30"> <!--todo: margin: main-card? page-content? page-content-card? page-margin?-->
        <Border Classes="rounded" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="10">
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <TextBox 
                                 HorizontalAlignment="Stretch" PlaceholderText="Enter search text..." 
                                 Text="{Binding SearchText}"/>
                        
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                        <ComboBox SelectedItem="{Binding Level}" 
                                  ItemsSource="{Binding AvailableLogLevelOptions}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <log:LogLevelIcon Grid.Column="0" 
                                                          VerticalAlignment="Center"
                                                          Level="{Binding}" />
                                        <TextBlock Grid.Column="1" 
                                                   VerticalAlignment="Center"
                                                   Text="{Binding}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <controls:MultiSelectFilter 
                                                    DataContext="{Binding SourceFilter}" 
                                                    ItemsSource="{Binding Selections}">
                            <controls:MultiSelectFilter.SummaryContent>
                                <Panel Classes="filter-summary">
                                    <TextBlock IsVisible="{Binding !ActiveSelections.Any}" 
                                               Text="All sources" />
                                    
                                    <TextBlock IsVisible="{Binding IsOnlySingleNameActive}">
                                        <Run Classes="mono" Text="{Binding FirstActiveName}" />
                                    </TextBlock>
                                    
                                    <TextBlock IsVisible="{Binding IsOnlyNoNameActive}"
                                               Text="Unnamed source" />
                                    
                                    <TextBlock IsVisible="{Binding AreOnlyMultipleNamesActive}">
                                        <Run Text="{Binding ActiveSelections.Count}" />
                                        <Run>sources</Run>
                                    </TextBlock>
                                    
                                    <TextBlock IsVisible="{Binding IsMixedFilteringActive}">
                                        <Run Text="{Binding ActiveSelections.Count}" />
                                        <Run>sources</Run>
                                    </TextBlock>
                                </Panel>
                            </controls:MultiSelectFilter.SummaryContent>
                            
                            <controls:MultiSelectFilter.DataTemplates>
                                <DataTemplate x:DataType="filter:NamedFilterSelection">
                                    <TextBlock Classes="mono" Text="{Binding Name}" />
                                </DataTemplate>
                                <DataTemplate x:DataType="filter:NoNameFilterSelection">
                                    <TextBlock>(unnamed source)</TextBlock>
                                </DataTemplate>
                            </controls:MultiSelectFilter.DataTemplates>
                        </controls:MultiSelectFilter>
                        
                        <controls:MultiSelectFilter 
                                                    DataContext="{Binding InstanceFilter}"
                                                    ItemsSource="{Binding Selections}">
                            <controls:MultiSelectFilter.SummaryContent>
                                <Panel Classes="filter-summary">
                                    <TextBlock IsVisible="{Binding !ActiveSelections.Any}" 
                                               Text="All instances" />

                                    <TextBlock IsVisible="{Binding IsOnlySingleNameActive}" >
                                        <Run Classes="mono" Text="{Binding FirstActiveName}" />
                                    </TextBlock>
                                    
                                    <TextBlock IsVisible="{Binding IsOnlyNoNameActive}" 
                                               Text="No instance" />
                                    
                                    <TextBlock IsVisible="{Binding AreOnlyMultipleNamesActive}">
                                        <Run Text="{Binding ActiveSelections.Count}" />
                                        <Run>instances</Run>
                                    </TextBlock>
                                    
                                    <TextBlock IsVisible="{Binding AreSingleNameAndNoNameActive}">
                                        <Run Classes="mono" Text="{Binding FirstActiveName}" />
                                        <Run>+ none</Run>
                                        
                                    </TextBlock>
                                    
                                    <TextBlock IsVisible="{Binding AreMultipleNamesAndNoNameActive}">
                                        <Run Text="{Binding ActiveNamesCount}" />
                                        <Run>instances + none</Run>
                                    </TextBlock>
                                </Panel>
                            </controls:MultiSelectFilter.SummaryContent>
                            
                            <controls:MultiSelectFilter.DataTemplates>
                                <DataTemplate x:DataType="filter:NamedFilterSelection">
                                    <TextBlock Classes="mono" Text="{Binding Name}" />
                                </DataTemplate>
                                <DataTemplate x:DataType="filter:NoNameFilterSelection">
                                    <TextBlock>(no instance)</TextBlock>
                                </DataTemplate>
                            </controls:MultiSelectFilter.DataTemplates>
                        </controls:MultiSelectFilter>
                        </WrapPanel>

                    </StackPanel>
                </Border>
                
                <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" IsVisible="{Binding IsFiltering}"/>

                <TableView ItemsSource="{Binding FilteredEntries}" 
                           Background="{DynamicResource PrimaryBackground}"
                           Margin="0 10 0 0" MinWidth="300"
                           HorizontalAlignment="Left"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <TableView.Resources>
                        <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="Transparent" />
                    </TableView.Resources>
                    <TableView.Styles>
                        <Style Selector="Border">
                            <Setter Property="BoxShadow" Value="0 2 4 0 #1F000000" /> <!--todo: top-bar shadow resource-->
                        </Style>
                        
                        <Style Selector="TableViewColumnHeader TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </TableView.Styles>
                    <TableView.Columns>
                        <TableViewColumn Width="28" CanUserResize="False">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate>
                                    <log:LogLevelIcon VerticalAlignment="Top" Level="{Binding Level}" />
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                        
                        <TableViewColumn Header="Time" Width="*">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="mono" Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                               ToolTip.Tip="{Binding Timestamp, StringFormat=dd MMM yyyy HH:mm:ss.fff}"/>
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                        
                        <TableViewColumn Header="Source" Width="1.3*">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="mono" Text="{Binding SourceModule}"
                                               ToolTip.Tip="{Binding SourceModule}"/>
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                        
                        <TableViewColumn Header="Instance" Width="1.3*">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="mono" Text="{Binding InstanceName}"
                                               ToolTip.Tip="{Binding InstanceName}"/>
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                        
                        <TableViewColumn Header="Message" Width="4*" Binding="{Binding Message}">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"
                                               ToolTip.Tip="{Binding Message}"/>
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                    </TableView.Columns>
                </TableView>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
