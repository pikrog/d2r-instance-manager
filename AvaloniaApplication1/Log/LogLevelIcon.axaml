<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:semantic="clr-namespace:AvaloniaApplication1.Semantic"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Log.LogLevelIcon"
             x:Name="Root">
    <Svg Width="16"
         semantic:SemanticClass.Type="{Binding SemanticType, ElementName=Root}"
         Path="{Binding IconPath, ElementName=Root}" />
</UserControl>