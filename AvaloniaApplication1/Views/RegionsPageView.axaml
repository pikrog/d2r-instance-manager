<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:AvaloniaApplication1.ViewModels"
             xmlns:services="using:AvaloniaApplication1.Services"
             xmlns:designViewModels="using:AvaloniaApplication1.Design.ViewModels"
             xmlns:controls="using:AvaloniaApplication1.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Views.RegionsPageView"
             x:DataType="viewModels:RegionsPageViewModel"
             services:DialogService.Register="{Binding}">
    <Design.DataContext>
        <designViewModels:RegionsPageDesignViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="controls|EditableCard.tile,controls|AddCard.tile">
            <Setter Property="Width" Value="300" />
            <Setter Property="MinHeight" Value="160" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Cards}" ClipToBounds="False" Margin="30">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="30" LineSpacing="30" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="viewModels:RegionCardViewModel">
                    <controls:EditableCard Classes="tile"
                                           VerticalAlignment="Top"
                                           Title="{Binding Name}" Subtitle="{Binding Address}"
                                           IsEdited="{Binding EditForm,Converter={x:Static ObjectConverters.IsNotNull}}"
                                           EditCommand="{Binding $parent[UserControl].((viewModels:RegionsPageViewModel)DataContext).EditCommand}"
                                           DeleteCommand="{Binding $parent[UserControl].((viewModels:RegionsPageViewModel)DataContext).DeleteCommand}"
                                           AcceptCommand="{Binding $parent[UserControl].((viewModels:RegionsPageViewModel)DataContext).SaveCommand}"
                                           DiscardCommand="{Binding $parent[UserControl].((viewModels:RegionsPageViewModel)DataContext).EndEditCommand}"
                                           EditCommandParameter="{Binding}"
                                           DeleteCommandParameter="{Binding}"
                                           AcceptCommandParameter="{Binding EditForm}"
                                           DiscardCommandParameter="{Binding EditForm}">
                        <controls:EditableCard.IsDimmed>
                            <MultiBinding Converter="{StaticResource ReferenceNotNullAndNotEqualsConverter}">
                                <Binding
                                    Path="$parent[ItemsControl].((viewModels:RegionsPageViewModel)DataContext).EditedCard" />
                                <Binding />
                            </MultiBinding>
                        </controls:EditableCard.IsDimmed>
                        <controls:EditableCard.EditContent>
                            <StackPanel Orientation="Vertical" Spacing="14" DataContext="{Binding EditForm}">
                                <controls:FormField Label="Name" Text="{Binding Name}" />
                                <controls:FormField Label="Address" Text="{Binding Address}" />
                            </StackPanel>
                        </controls:EditableCard.EditContent>
                    </controls:EditableCard>
                </DataTemplate>
                <DataTemplate x:DataType="viewModels:AddCardViewModel">
                    <controls:AddCard Classes="tile"
                                      VerticalAlignment="Top"
                                      Command="{Binding $parent[UserControl].((viewModels:RegionsPageViewModel)DataContext).NewCommand}"
                                      IsDimmed="{Binding $parent[UserControl].((viewModels:RegionsPageViewModel)DataContext).EditedCard,Converter={x:Static ObjectConverters.IsNotNull}}" />
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
    </ScrollViewer>
</UserControl>