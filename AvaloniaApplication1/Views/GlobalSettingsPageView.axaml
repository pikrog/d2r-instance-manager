<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:AvaloniaApplication1.ViewModels"
             xmlns:controls="clr-namespace:AvaloniaApplication1.Controls"
             xmlns:services="clr-namespace:AvaloniaApplication1.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Views.GlobalSettingsPageView"
             x:DataType="viewModels:GlobalSettingsPageViewModel"
             services:DialogService.Register="{Binding}">
    <ScrollViewer>
            <StackPanel Name="Panel" Margin="40">
                <StackPanel.Styles>
                    <Style Selector="controls|Section">
                        <Setter Property="Margin" Value="0 8 0 2"/>    <!--todo: StackPanel spacing + StackPanel per label + input-->
                    </Style>
                    <Style Selector="StackPanel > TextBox,ComboBox,CheckBox,controls|HotkeyBox">
                        <Setter Property="Margin" Value="0 0 0 16"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                    <Style Selector="StackPanel > TextBlock"> 
                        <Setter Property="Margin" Value="0,0,0,4"/> 
                    </Style>
                </StackPanel.Styles>
                
                <TextBlock x:Name="GameExecutablePathLabel">Game executable path</TextBlock>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">

                    <TextBox Grid.Column="0" Classes="h1" 
                             AutomationProperties.LabeledBy="{Binding #GameExecutablePathLabel}"
                             Text="{Binding GameExecutablePath}"/>
                    <Button Grid.Column="1" Classes="action" Command="{Binding BrowseForGameExecutablePathCommand}">
                        <Image Source="{SvgImage /Assets/images/browse.svg}"/>
                    </Button>
                    <Button Grid.Column="2" Classes="action" Command="{Binding AutoDetectGameExecutablePathCommand}">
                        <Image Source="{SvgImage /Assets/images/auto.svg}"/>
                    </Button>
                </Grid>

                <controls:Section Title="Default authentication"/>
                
                <TextBlock>Credentials vector</TextBlock>
                <ComboBox>Command-line arguments</ComboBox>
                
                <CheckBox>Enable automated token acquisition</CheckBox>
                
                <controls:Section Title="Behavior"/>

                <CheckBox IsChecked="{Binding FallbackToPrimaryDisplayIfInvalid}"
                          Margin="0 0 0 8">Fall back to the primary display if the target display is unavailable</CheckBox>
                <CheckBox IsChecked="{Binding CenterMouseCursorInRecalledWindow}"
                          Margin="0 0 0 8">Center the mouse cursor when showing an instance window</CheckBox>
                <CheckBox IsChecked="{Binding CloseInstancesOnAppExit}"
                          Margin="0 0 0 8">Close all instances on application exit</CheckBox>
            </StackPanel>
        </ScrollViewer>
</UserControl>
