<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApplication1.App"
             xmlns:local="using:AvaloniaApplication1"
             xmlns:converters="clr-namespace:AvaloniaApplication1.Common.Converters"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PrimaryBackground">White</SolidColorBrush>
                    <Color x:Key="PrimaryForegroundColor">Black</Color>
                    <SolidColorBrush x:Key="PrimaryForeground" Color="{StaticResource PrimaryForegroundColor}"/>
                    <SolidColorBrush x:Key="PrimaryHoverBackground" Opacity="0.05" Color="#0B0BA0" />
                    
                    <SolidColorBrush x:Key="SecondaryForeground">#666666</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="AccentPrimaryBackground">#EEF6FD</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentPrimaryHoverBackground">#D8EBFA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentPrimaryPressedBackground">#BDDDF6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentPrimaryOutline">#4C9ED9</SolidColorBrush>
                    <Color x:Key="AccentPrimaryContentColor">#245D86</Color>
                    <SolidColorBrush x:Key="AccentPrimaryContent" Color="{StaticResource AccentPrimaryContentColor}" />
                    
                    <SolidColorBrush x:Key="AccentSecondaryBackground">LightBlue</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="SubtleBackground">#F9F9FE</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="DisabledForeground">#40000000</SolidColorBrush>

                    <SolidColorBrush x:Key="DangerBackground">#FDF0EE</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerHoverBackground">#F9DAD6</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerPressedBackground">#F4C0BA</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerOutline">#E87A70</SolidColorBrush>
                    <Color x:Key="DangerContentColor">#B54C44</Color>
                    <SolidColorBrush x:Key="DangerContent" Color="{StaticResource DangerContentColor}" />
                    
                    <SolidColorBrush x:Key="WarningBackground">#FFF7E8</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningHoverBackground">#FDECC8</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningPressedBackground">#F9DF9F</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningOutline">#E3A008</SolidColorBrush>
                    <Color x:Key="WarningContentColor">#8A5A00</Color>
                    <SolidColorBrush x:Key="WarningContent" Color="{StaticResource WarningContentColor}" />
                    
                    <SolidColorBrush x:Key="SuccessBackground">#EEF8F1</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessHoverBackground">#D8EFDE</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessPressedBackground">#BFE4CA</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessOutline">#4FA86B</SolidColorBrush>
                    <Color x:Key="SuccessContentColor">#2E6A41</Color>
                    <SolidColorBrush x:Key="SuccessContent" Color="{StaticResource SuccessContentColor}" />
                    
                    <SolidColorBrush x:Key="InfoBackground">#EEF6FD</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoHoverBackground">#D8EBFA</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoPressedBackground">#BDDDF6</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoOutline">#4C9ED9</SolidColorBrush>
                    <Color x:Key="InfoContentColor">#245D86</Color>
                    <SolidColorBrush x:Key="InfoContent" Color="{StaticResource InfoContentColor}" />
                    
                    <SolidColorBrush x:Key="PrimaryOutline">#e5e7eb</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="SectionUnderline">#DDDD</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="EvenRowBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="OddRowBackground">#F9F9F9</SolidColorBrush>
                    
                    <BoxShadows x:Key="NavTabBoxShadow">0 0 64 0 #14000000</BoxShadows>
                    <BoxShadows x:Key="HoveringBoxShadow">0 16 32 -4 #14000000</BoxShadows>
                    <BoxShadows x:Key="DepressedBoxShadow">inset 0 1 3 0 #80000000</BoxShadows>
                    <BoxShadows x:Key="BottomShadow">0 2 4 0 #1F000000</BoxShadows>
                    <BoxShadows x:Key="TopShadow">0 -2 4 0 #1F000000</BoxShadows>
                    
                    <Bitmap x:Key="AppLogo">/Assets/images/logo.png</Bitmap>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PrimaryBackground">#1E1E1E</SolidColorBrush>
                    <Color x:Key="PrimaryForegroundColor">#F2F2F2</Color>
                    <SolidColorBrush x:Key="PrimaryForeground" Color="{StaticResource PrimaryForegroundColor}"/>
                    <SolidColorBrush x:Key="PrimaryHoverBackground" Opacity="0.12" Color="#8C8CFF" />

                    <SolidColorBrush x:Key="SecondaryForeground">#A0A0A0</SolidColorBrush>

                    <SolidColorBrush x:Key="AccentPrimaryBackground">#14283A</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentPrimaryHoverBackground">#1B3750</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentPrimaryPressedBackground">#234765</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentPrimaryOutline">#4C9ED9</SolidColorBrush>
                    <Color x:Key="AccentPrimaryContentColor">#8CC8F2</Color>
                    <SolidColorBrush x:Key="AccentPrimaryContent" Color="{StaticResource AccentPrimaryContentColor}" />

                    <SolidColorBrush x:Key="AccentSecondaryBackground">#2F5F7A</SolidColorBrush>

                    <SolidColorBrush x:Key="SubtleBackground">#262629</SolidColorBrush>

                    <SolidColorBrush x:Key="DisabledForeground">#59FFFFFF</SolidColorBrush>

                    <SolidColorBrush x:Key="DangerBackground">#3A1A17</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerHoverBackground">#4D221E</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerPressedBackground">#612B26</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerOutline">#E87A70</SolidColorBrush>
                    <Color x:Key="DangerContentColor">#F5A29A</Color>
                    <SolidColorBrush x:Key="DangerContent" Color="{StaticResource DangerContentColor}" />

                    <SolidColorBrush x:Key="WarningBackground">#3A2D0F</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningHoverBackground">#4D3C14</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningPressedBackground">#614C1A</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningOutline">#E3A008</SolidColorBrush>
                    <Color x:Key="WarningContentColor">#F2C45C</Color>
                    <SolidColorBrush x:Key="WarningContent" Color="{StaticResource WarningContentColor}" />

                    <SolidColorBrush x:Key="SuccessBackground">#162B1E</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessHoverBackground">#1E3A28</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessPressedBackground">#274A33</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessOutline">#4FA86B</SolidColorBrush>
                    <Color x:Key="SuccessContentColor">#8FD4A5</Color>
                    <SolidColorBrush x:Key="SuccessContent" Color="{StaticResource SuccessContentColor}" />

                    <SolidColorBrush x:Key="InfoBackground">#14283A</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoHoverBackground">#1B3750</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoPressedBackground">#234765</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoOutline">#4C9ED9</SolidColorBrush>
                    <Color x:Key="InfoContentColor">#8CC8F2</Color>
                    <SolidColorBrush x:Key="InfoContent" Color="{StaticResource InfoContentColor}" />

                    <SolidColorBrush x:Key="PrimaryOutline">#3A3A3F</SolidColorBrush>

                    <SolidColorBrush x:Key="SectionUnderline">#44FFFFFF</SolidColorBrush>

                    <SolidColorBrush x:Key="EvenRowBackground">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="OddRowBackground">#252526</SolidColorBrush>
                    
                    <BoxShadows x:Key="NavTabBoxShadow">0 0 48 0 #66000000</BoxShadows>
                    <BoxShadows x:Key="HoveringBoxShadow">0 16 32 -4 #80000000</BoxShadows>
                    <BoxShadows x:Key="DepressedBoxShadow">inset 0 1 3 0 #B3000000</BoxShadows>
                    <BoxShadows x:Key="BottomShadow">0 2 4 0 #66000000</BoxShadows>
                    <BoxShadows x:Key="TopShadow">0 -2 4 0 #66000000</BoxShadows>
                    
                    <Bitmap x:Key="AppLogo">/Assets/images/logo-dark.png</Bitmap>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <StreamGeometry x:Key="ErrorGeometry">M14,7 A7,7 0 0,0 0,7 M0,7 A7,7 0 1,0 14,7 M7,3l0,5 M7,9l0,2</StreamGeometry>
            <StreamGeometry x:Key="SpinnerGeometry">M12,2 A10,10 0 1 1 11.99,2</StreamGeometry>

            <x:Double x:Key="UnrevealedOpacity">0.25</x:Double>
            <Thickness x:Key="MaximallyThin">0.67</Thickness>
            <CornerRadius x:Key="CornerRadius">6</CornerRadius>

            <converters:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter" />
            <converters:ReferenceNotEqualsConverter x:Key="ReferenceNotEqualsConverter" />
            <converters:ReferenceNotNullAndNotEqualsConverter x:Key="ReferenceNotNullAndNotEqualsConverter" />
            <converters:IsPageTypeConverter x:Key="IsPageTypeConverter" />
            <converters:CollectionIsEmptyConverter x:Key="CollectionIsEmptyConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:BrushToColorConverter x:Key="BrushToColorConverter" />
            <converters:KeyCombinationToKeyGestureConverter x:Key="KeyCombinationToKeyGestureConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="/Styles.axaml" />

        <StyleInclude Source="/Controls/RevealableContent.axaml" />
        <StyleInclude Source="/Controls/Section.axaml" />
        <StyleInclude Source="/Controls/HotkeyBox.axaml" />
        <StyleInclude Source="/Card/Views/Card.axaml" />
        <StyleInclude Source="/Controls/Spinner.axaml" />
        <StyleInclude Source="/Controls/NavTab.axaml" />
        <StyleInclude Source="/Controls/MultiSelectFilter.axaml" />
        <StyleInclude Source="/Controls/Badged.axaml" />
    </Application.Styles>
</Application>
