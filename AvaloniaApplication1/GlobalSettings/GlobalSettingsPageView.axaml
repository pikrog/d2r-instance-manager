<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AvaloniaApplication1.Controls"
             xmlns:dialog="clr-namespace:AvaloniaApplication1.Dialog"
             xmlns:globalSettings="clr-namespace:AvaloniaApplication1.GlobalSettings"
             xmlns:design="clr-namespace:AvaloniaApplication1.Design.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.GlobalSettings.GlobalSettingsPageView"
             x:DataType="globalSettings:GlobalSettingsPageViewModel"
             dialog:DialogService.Register="{Binding}">
    <Design.DataContext>
        <design:GlobalSettingsPageDesignViewModel />
    </Design.DataContext>
    
    <Border Classes="outlined hovering rounded" Padding="15">
        <ScrollViewer>
            <StackPanel>
                <StackPanel.Styles>
                    <Style Selector="controls|Section">
                        <Setter Property="Margin" Value="0 8 0 2"/>    <!--todo: StackPanel spacing + StackPanel per label + input-->
                    </Style>
                    <Style Selector="StackPanel > TextBox,ComboBox,CheckBox,controls|HotkeyBox">
                        <Setter Property="Margin" Value="0 0 0 16"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                    <Style Selector="StackPanel > TextBlock"> 
                        <Setter Property="Margin" Value="0,0,0,4"/> 
                    </Style>
                </StackPanel.Styles>
                
                <TextBlock x:Name="GameExecutablePathLabel">Game executable path</TextBlock>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">

                    <TextBox Grid.Column="0" Classes="h1" 
                             AutomationProperties.LabeledBy="{Binding #GameExecutablePathLabel}"
                             Text="{Binding GameExecutablePath}"/>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseForGameExecutablePathCommand}">
                        <Svg Classes="default-foreground" Path="/Assets/images/browse.svg" />
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding AutoDetectGameExecutablePathCommand}">
                        <Svg Classes="default-foreground" Path="/Assets/images/auto.svg" />
                    </Button>
                </Grid>

                <controls:Section Title="Behavior"/>

                <CheckBox IsChecked="{Binding FallbackToPrimaryDisplayIfInvalid}"
                          Margin="0 0 0 8">Fall back to the primary display if the target display is unavailable</CheckBox>
                <CheckBox IsChecked="{Binding CenterMouseCursorInShownWindow}"
                          Margin="0 0 0 8">Center the mouse cursor when showing an instance window</CheckBox>
                
                <controls:Section Title="Password protection" />
                
                <StackPanel Orientation="Vertical">
                    <RadioButton GroupName="encryption" 
                                 IsChecked="{Binding IsProtectionDisabledSelected,Mode=OneWay}" 
                                 Command="{Binding SelectProtectionOptionCommand}" 
                                 CommandParameter="{x:Static globalSettings:ProtectionSelection.Disabled}">
                        Disabled
                    </RadioButton>
                    <RadioButton GroupName="encryption" 
                                 IsChecked="{Binding IsProtectionByWindowsAccountSelected,Mode=OneWay}"
                                 Command="{Binding SelectProtectionOptionCommand}" 
                                 CommandParameter="{x:Static globalSettings:ProtectionSelection.ProtectedByWindowsAccount}">
                        Protected by your Windows account
                    </RadioButton>
                    
                    <Grid ColumnDefinitions="Auto, *">
                        <RadioButton Grid.Column="0" GroupName="encryption" 
                                     IsChecked="{Binding IsProtectionByPassphraseSelected,Mode=OneWay}"
                                     Command="{Binding SelectProtectionOptionCommand}" 
                                     CommandParameter="{x:Static globalSettings:ProtectionSelection.ProtectedByPassphrase}">
                            Protected by a passphrase
                        </RadioButton>
                        
                        <Button Grid.Column="1" HorizontalAlignment="Right"
                                Classes="neutral"
                                IsEnabled="{Binding IsProtectionByPassphraseSelected}"
                                Command="{Binding SetPassphraseCommand}"
                                ToolTip.ShowOnDisabled="True"
                                ToolTip.ServiceEnabled="{Binding !IsProtectionByPassphraseSelected}">
                            <ToolTip.Tip>
                                <TextBlock>
                                    You can set the passphrase only when using the
                                    <Run FontWeight="Bold">[Protected by a passphrase]</Run>
                                    password protection option.
                                </TextBlock>
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Svg Classes="default-foreground"  Path="/Assets/images/key.svg" Height="20"/>
                                <TextBlock>Set the passphrase</TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
