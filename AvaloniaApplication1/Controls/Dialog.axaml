<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="170"
             x:Class="AvaloniaApplication1.Controls.Dialog"
             x:Name="Root">
    <Border Classes="hovering rounded outlined" 
            Margin="12" Padding="12" MinWidth="300" MinHeight="150"
            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PrimaryBackground}">
        <DockPanel>
            <ContentControl DockPanel.Dock="Bottom" Margin="0 24 0 0"  HorizontalAlignment="Right" Content="{Binding #Root.Footer}"/>
            <StackPanel Margin="8" Spacing="16">
                <ContentControl Content="{Binding #Root.Header}" />
                <ContentControl Content="{Binding #Root.Body}" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
