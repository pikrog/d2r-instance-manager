<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="using:D2RInstanceManager.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Vertical" Spacing="16">
            <cc:Section Title="First">
                <TextBlock>Text under the section</TextBlock>
            </cc:Section>
        
            <cc:Section Title="Test section">
                <TextBlock>Text under the section</TextBlock>
            </cc:Section>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="cc|Section">
        <Setter Property="IsSeparatorVisible" Value="True" />
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cc:Section}">
                    <StackPanel Spacing="8">
                        <Border Name="Separator"
                                IsVisible="{TemplateBinding IsSeparatorVisible}"
                                Height="1" Background="{DynamicResource SectionUnderline}" />
                        <TextBlock Classes="h2" Text="{TemplateBinding Title}"/>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                     </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="cc|Section:nth-child(1)">
        <Setter Property="IsSeparatorVisible" Value="False" />
    </Style>
</Styles>
