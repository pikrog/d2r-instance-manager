<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AvaloniaApplication1.Controls">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource PrimaryBackgroundGradient}" Width="200">
      <!-- Add Controls for Previewer Here -->
      <Button Content="Hello"></Button>
    </Border>
  </Design.PreviewWith>
  
  <!--<Style Selector="StackPanel.form">
    <Setter Property="Margin" Value="15"/>
    
    <Style Selector="^ cc|Section">
      <Setter Property="Margin" Value="0 8 0 2"/>    
    </Style>
    <Style Selector="^ TextBox,ComboBox,CheckBox">
      <Setter Property="Margin" Value="0 0 0 16"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="^ TextBlock"> 
      <Setter Property="Margin" Value="0,0,0,4"/> 
    </Style>
  </Style>-->
  
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  
  <Style Selector="TextBox.h1">
    <Setter Property="FontSize" Value="18"/>
  </Style>
  
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  
  <Style Selector="TextBlock.subh2">
    <Setter Property="Opacity" Value="0.7"/>
  </Style>
  
  <Style Selector="Border.hovering">
    <Setter Property="BoxShadow" Value="0 16 32 -4 #14000000"/>
  </Style>
  
  <Style Selector="Border.depressed">
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #80000000"/>
  </Style>
  
  <Style Selector="Border.dimmed">
    <Setter Property="Opacity" Value="0.25"/>
  </Style>
  
  <Style Selector="Border">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>
  
  <Style Selector="Button.action">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Height" Value="36"/>
  </Style>
  
  <Style Selector="Grid.hover-highlight">
    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
  </Style>
  
  <Style Selector=":is(Control).hover-revealed">
    <Setter Property="Opacity" Value="0.25"></Setter>
  </Style>
  
  <Style Selector=":is(Control).hoverable-parent:pointerover :is(Control).hover-revealed">
    <Setter Property="Opacity" Value="1"></Setter>
  </Style>
  
  <!-- <Style Selector="Button.primary"> -->
  <!--   <Setter Property="Background" Value="#4CAF50"/> -->
  <!--   <Setter Property="Foreground" Value="White"/> -->
  <!--   <Setter Property="Padding" Value="8"/> -->
  <!-- </Style> -->
  <!-- -->
  <!-- <Style Selector="Button.primary:pointerover /template/ ContentPresenter"> -->
  <!--   <Setter Property="Background" Value="#43A047"/> -->
  <!-- </Style> -->
  <!-- -->
  <!-- <Style Selector="Button.primary:pressed /template/ ContentPresenter"> -->
  <!--   <Setter Property="Background" Value="#388E3C"/> -->
  <!-- </Style> -->
  
  <Style Selector="Border.rounded">
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  
  <Style Selector="Border.outlined">
    <Setter Property="BorderBrush" Value="#e5e7eb"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  
  <Style Selector="Button.rounded">
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  
  <Style Selector="RadioButton.nav-tab">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background" Classes="rounded" Padding="2,16" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  
  <Style Selector="RadioButton.nav-tab:checked /template/ Border#PART_Background">
    <Setter Property="Background" Value="LightBlue"/>
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #80000000"/>
  </Style>
  
  <Style Selector="RadioButton.nav-tab:pointerover:not(:checked) /template/ Border#PART_Background">
    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
  </Style>
  
  <Style Selector="RadioButton.nav-tab:pressed /template/ Border#PART_Background">
    <Setter Property="Background" Value="#505050"/>
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #80000000"/>
  </Style>
</Styles>
