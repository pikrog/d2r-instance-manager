<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:designViewModels="clr-namespace:AvaloniaApplication1.Design.ViewModels"
             xmlns:controls="clr-namespace:AvaloniaApplication1.Controls"
             xmlns:viewModels="clr-namespace:AvaloniaApplication1.Instance.ViewModels"
             xmlns:dialog="clr-namespace:AvaloniaApplication1.Dialog"
             xmlns:semantic="clr-namespace:AvaloniaApplication1.Semantic"
             xmlns:instanceIssues="clr-namespace:AvaloniaApplication1.Instance.Models.Issues"
             xmlns:settingsIssues="clr-namespace:AvaloniaApplication1.GlobalSettings.Issues"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Root"
             x:Class="AvaloniaApplication1.Instance.Views.InstancesPageView"
             x:DataType="viewModels:InstancesPageViewModel"
             dialog:DialogService.Register="{Binding}">
    <Design.DataContext>
        <designViewModels:InstancesPageDesignViewModel />
    </Design.DataContext>
    
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="instanceIssues:MissingDisplay">
            <WrapPanel>
                <TextBlock IsVisible="{Binding !IsFallbackAllowed}">
                    <Run>The selected display</Run>
                    <Span FontWeight="Bold">
                        <Run>"</Run><Run Text="{Binding Display.Description}" />
                        <Run>[</Run><Run Text="{Binding Display.Width}"/><Run>x</Run><Run Text="{Binding Display.Height}" /><Run>]"</Run>
                    </Span>
                    <Run>is not connected.</Run>
                </TextBlock>
                <TextBlock IsVisible="{Binding IsFallbackAllowed}">
                    <Run>The selected display</Run>
                    <Span FontWeight="Bold">
                        <Run>"</Run><Run Text="{Binding Display.Description}" />
                        <Run>[</Run><Run Text="{Binding Display.Width}"/><Run>x</Run><Run Text="{Binding Display.Height}" /><Run>]"</Run>
                    </Span>
                    <Run>is not connected. Will use the primary display.</Run>
                </TextBlock>
            </WrapPanel>
        </DataTemplate>
        <DataTemplate x:DataType="instanceIssues:DeletedAccount">
            <TextBlock>The instance refers to a deleted account.</TextBlock>
        </DataTemplate>
        <DataTemplate x:DataType="instanceIssues:DeletedRegion">
            <TextBlock>The instance refers to a deleted region.</TextBlock>
        </DataTemplate>
        <DataTemplate x:DataType="instanceIssues:MissingAccount">
            <TextBlock>The instance has online mode enabled but is missing an account.</TextBlock>
        </DataTemplate>
        <DataTemplate x:DataType="instanceIssues:MissingRegion">
            <TextBlock>The instance has online mode enabled but is missing a region.</TextBlock>
        </DataTemplate>
        
        <DataTemplate x:DataType="settingsIssues:MissingExecutablePath">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">The game executable is missing. Configure the game path in
                <Run Classes="link">Global Settings</Run> 
                to launch instances.
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:DataType="settingsIssues:ExecutableFileNotFound">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">The game executable file
                "<Run FontWeight="Bold" Text="{Binding Path}"/>"
                was not found. Fix the game path in
                <Run Classes="link">Global Settings</Run> 
                to launch instances.
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:DataType="settingsIssues:InvalidExecutableFileFormat">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">The game executable file
                "<Run FontWeight="Bold" Text="{Binding Path}"/>"
                is not a valid 64-bit executable binary. Fix the game path in
                <Run Classes="link">Global Settings</Run> 
                to launch instances.
            </TextBlock>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="ItemsControl.table > ContentPresenter:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource EvenRowBackground}" />
        </Style>
        <Style Selector="ItemsControl.table > ContentPresenter:nth-child(2n+1)">
            <Setter Property="Background" Value="{DynamicResource OddRowBackground}" />
        </Style>
        
        <Style Selector="ItemsControl.table > ContentPresenter:pointerover controls|RevealableContent">
            <Setter Property="IsRevealed" Value="True" />
        </Style>
        
        <Style Selector="ItemsControl.table > ContentPresenter:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBackground}" />
        </Style>

        <Style Selector="Button.toolbar-action"> <!--todo: cleanup these styles-->
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="12 12" />
            <Setter Property="Width" Value="105" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.toolbar-action StackPanel"> 
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
        </Style>

        <Style Selector="Button.toolbar-action TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.toolbar-action Svg">
            <Setter Property="Height" Value="20" />
        </Style>
    </UserControl.Styles>

    <Border Classes="outlined hovering rounded" Margin="30">
        <Border Classes="rounded" ClipToBounds="True">
            <DockPanel Grid.IsSharedSizeScope="True">
                <Border DockPanel.Dock="Top"
                        BoxShadow="0 2 4 0 #1F000000"
                        ZIndex="1">
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="toolbar-action"
                                Command="{Binding NewCommand}">
                            <DockPanel>
                                <Svg Path="/Assets/images/add-square.svg" />
                                <TextBlock>New</TextBlock>
                            </DockPanel>
                        </Button>
                    </WrapPanel>
                </Border>
                
                <Border DockPanel.Dock="Bottom"
                        BoxShadow="0 -2 4 0 #1F000000"
                        ZIndex="1"
                        >
                    <StackPanel>
                        <Border Padding="20 15"
                                IsVisible="{Binding SelectedInstances.Any}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="A" Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Classes="icon" 
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ClearSelectionCommand}">
                                    <Svg Path="/Assets/images/arrow-left.svg" Width="20" />
                                </Button>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedInstances.Count}"/>
                                    instances selected
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Classes="icon danger" Command="{Binding StopSelectedCommand}">
                                        <Svg Classes="inherit-foreground" Path="/Assets/images/close.svg" />
                                    </Button>
                                    <Button Classes="icon success" Command="{Binding LaunchSelectedCommand}">
                                        <Svg Classes="inherit-foreground" Path="/Assets/images/play.svg" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource DangerBackground}" Padding="10"
                                IsVisible="{Binding FirstGlobalSettingsIssue, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                                <Svg Grid.Column="0" Classes="icon inherit-foreground danger" Height="24" Path="/Assets/images/error.svg" />
                                <ContentControl Grid.Column="1" Content="{Binding FirstGlobalSettingsIssue}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                    
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl 
                                      Classes="table" FontSize="16"
                                      ItemsSource="{Binding Instances}" ClipToBounds="False"
                                      IsVisible="{Binding !IsTableEmpty}">

                            <ItemsControl.DataTemplates>
                                <DataTemplate x:DataType="viewModels:GameInstanceItemViewModel">
                                    <Grid Margin="20 15" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="A" Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition SharedSizeGroup="B" Width="Auto" />
                                            <ColumnDefinition SharedSizeGroup="C" Width="Auto" />
                                            <ColumnDefinition SharedSizeGroup="D" Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" 
                                                  HorizontalAlignment="Center" Padding="0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Text="{Binding Name}" />
                                            
                                        <controls:Spinner Grid.Column="2"
                                                          Opacity="{Binding IsInProgress, Converter={StaticResource BoolToOpacityConverter}}" />
                                            
                                        <ContentControl Grid.Column="2" Classes="icon hoverable warning" VerticalAlignment="Center">
                                            <ContentControl.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="!IsActive" />
                                                    <Binding Path="HasIssues" /> 
                                                    <Binding Path="!RequiresAttention" />
                                                </MultiBinding>
                                            </ContentControl.IsVisible>
                                                
                                            <ToolTip.Tip>
                                                <ToolTip>
                                                    <StackPanel Classes="tooltip-text">
                                                        <ItemsControl ItemsSource="{Binding Issues}" />
                                                        <Button Classes="link" HorizontalAlignment="Right" 
                                                                Command="{Binding DataContext.EditCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock>Fix now</TextBlock>
                                                        </Button>
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTip.Tip>
                                                
                                            <Svg Classes="inherit-foreground" Path="/Assets/images/warning.svg" />
                                        </ContentControl>
                                            
                                        <ContentControl Grid.Column="2" Classes="icon hoverable danger" VerticalAlignment="Center">
                                            <ContentControl.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="!IsActive" />
                                                    <Binding Path="RequiresAttention" />
                                                </MultiBinding>
                                            </ContentControl.IsVisible>
                                                
                                            <ToolTip.Tip>
                                                <ToolTip>
                                                    <StackPanel Classes="tooltip-text">
                                                        <ItemsControl ItemsSource="{Binding Issues}" />
                                                        <Button Classes="link" HorizontalAlignment="Right">Fix now</Button>
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTip.Tip>
                                                
                                            <Svg Classes="inherit-foreground" Path="/Assets/images/error.svg" />
                                        </ContentControl>
                                            
                                        <Border Grid.Column="3"
                                                semantic:SemanticClass.Type="{Binding StatusSemanticType}"
                                                Classes="chip"
                                                Width="120"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Text="{Binding Status}" />
                                        </Border>
                                        <controls:RevealableContent Grid.Column="4">
                                            <Grid ColumnDefinitions="30,30,30,30,30" HorizontalAlignment="Right">
                                                <Button Grid.Column="0" Classes="icon"
                                                        Command="{Binding DataContext.EditCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding !IsActive}">
                                                    <Svg Classes="inherit-foreground" Path="/Assets/images/edit.svg" />
                                                </Button>
                                                <Button Grid.Column="1" Classes="icon danger"
                                                        Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding !IsActive}">
                                                    <Svg Classes="inherit-foreground" Path="/Assets/images/delete.svg" />
                                                </Button>
                                                <Button Grid.Column="3" Classes="icon"
                                                        Command="{Binding DataContext.ShowCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsActive}">
                                                    <Svg Classes="inherit-foreground" Path="/Assets/images/show.svg" />
                                                </Button>
                                                <Button Grid.Column="4" Classes="icon danger"
                                                        Command="{Binding DataContext.StopCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding IsActive}"
                                                        IsEnabled="{Binding CanBeStopped}">
                                                    <Svg Classes="inherit-foreground" Path="/Assets/images/close.svg" />
                                                </Button>
                                                <Button Grid.Column="4" Classes="icon success"
                                                        Command="{Binding DataContext.LaunchCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding !IsActive}"
                                                        IsEnabled="{Binding !RequiresAttention}">
                                                    <Svg Classes="inherit-foreground" Path="/Assets/images/play.svg"  />
                                                </Button>
                                            </Grid>
                                        </controls:RevealableContent>
                                    </Grid> 
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock FontSize="20" Opacity="0.25"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding IsTableEmpty}">
                        Press [New] to create a new instance
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
