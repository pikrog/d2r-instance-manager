<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        Width="600" Height="400"
        WindowStartupLocation="CenterScreen"
        x:Class="AvaloniaApplication1.InitialWindowView"
        Title="D2R Instance Manager Splash Screen"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource PrimaryBackground}">
    <Window.Styles>
        <Style Selector="ProgressBar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>
    
    <DockPanel>
        <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Bottom" IsIndeterminate="True" Opacity="0"/>
        <StackPanel VerticalAlignment="Center" Spacing="16">
            <Image Source="/Assets/images/logo.png" Width="150" HorizontalAlignment="Center"/>
            <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center">D2R Instance Manager</TextBlock>
        </StackPanel>
    </DockPanel>
</Window>
